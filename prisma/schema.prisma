// ============================================================
// FRESHMART ERP — PRISMA SCHEMA v1.0
// Production-grade with full audit, price history, stock ledger
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_STAFF
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum PriceType {
  SELLING
  WHOLESALE
  PROMOTIONAL
  COST
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
  NONE
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIVE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED_REMOVAL
  EXPIRED_REMOVAL
  STOCK_TAKE_RECONCILIATION
  MANUAL_CORRECTION
}

enum StockMovementDirection {
  IN
  OUT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
  RETURNED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
  RETURNED
  PARTIAL_RETURNED
}

enum ReturnReason {
  DAMAGED
  EXPIRED
  CUSTOMER_RETURN
  WRONG_ITEM
  PRICING_ERROR
  SUPPLIER_ISSUE
  INTERNAL_ADJUSTMENT
  SPOILED_GOODS
  LOST_ITEM
  MANUAL_CORRECTION
}

enum PaymentMethod {
  CASH
  CARD
  KNET
  BANK_TRANSFER
  CREDIT
  SPLIT
}

enum CustomerType {
  WALKIN
  REGULAR
  CREDIT
  WHOLESALE
  DELIVERY
}

enum ShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum ApprovalAction {
  CREDIT_LIMIT_OVERRIDE
  PRICE_OVERRIDE
  HIGH_DISCOUNT
  DELETE_PRODUCT
  BULK_DELETE_PRODUCTS
  VOID_SALE
  EDIT_COMPLETED_INVOICE
  STOCK_ADJUSTMENT_HIGH
  RETURN_HIGH_VALUE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  ITEM_PERCENTAGE
  ITEM_FLAT
  CART_PERCENTAGE
  CART_FLAT
  BUY_X_GET_Y
  CATEGORY_PERCENTAGE
  BRAND_PERCENTAGE
  CUSTOMER_TYPE
  TIME_BASED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum SequenceDocType {
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  STOCK_ADJUSTMENT
  SHIFT
  RECEIPT
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  LOGIN
  LOGOUT
  PRICE_OVERRIDE
  DISCOUNT_OVERRIDE
  CREDIT_OVERRIDE
  VOID_SALE
  STOCK_ADJUST
  ROLE_CHANGE
  SETTINGS_CHANGE
  BACKUP
  RESTORE
  APPROVAL_REQUEST
  APPROVAL_GRANTED
  APPROVAL_REJECTED
}

model Branch {
  id        String       @id @default(uuid())
  code      String       @unique @db.VarChar(20)
  name      String       @db.VarChar(200)
  nameAr    String?      @db.VarChar(200)
  address   String?
  phone     String?      @db.VarChar(30)
  whatsapp  String?      @db.VarChar(30)
  email     String?      @db.VarChar(200)
  timezone  String       @default("Asia/Kuwait") @db.VarChar(50)
  status    BranchStatus @default(ACTIVE)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  warehouses     Warehouse[]
  users          User[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          SalesInvoice[]
  shifts         Shift[]
  sequences      DocumentSequence[]
  priceHistories ProductPriceHistory[]
  costHistories  ProductCostHistory[]
  promotions     Promotion[]
  expenses       Expense[]

  @@index([code])
  @@index([status])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid())
  branchId  String
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(200)
  isDefault Boolean   @default(false)
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch         Branch          @relation(fields: [branchId],   references: [id])
  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("warehouses")
}

model Role {
  id          String   @id @default(uuid())
  type        RoleType @unique
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId],       references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid())
  branchId     String?
  roleId       String
  username     String     @unique @db.VarChar(100)
  email        String     @unique @db.VarChar(200)
  passwordHash String     @db.VarChar(255)
  firstName    String     @db.VarChar(100)
  lastName     String     @db.VarChar(100)
  phone        String?    @db.VarChar(30)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])
  role   Role    @relation(fields: [roleId],   references: [id])

  auditLogs         AuditLog[]
  priceHistories    ProductPriceHistory[]
  costHistories     ProductCostHistory[]
  stockMovements    StockMovement[]
  approvalRequests  ApprovalRequest[]    @relation("ApprovalRequester")
  approvalResponses ApprovalRequest[]    @relation("ApprovalApprover")
  shifts            Shift[]
  salesInvoices     SalesInvoice[]
  purchases         Purchase[]
  importJobs        ImportJob[]

  @@index([username])
  @@index([email])
  @@index([branchId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(200)
  nameAr    String?   @db.VarChar(200)
  note      String?
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([name])
  @@index([deletedAt])
  @@map("brands")
}

model Category {
  id          String    @id @default(uuid())
  parentId    String?
  code        String?   @unique @db.VarChar(20)
  name        String    @db.VarChar(200)
  nameAr      String?   @db.VarChar(200)
  description String?
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([name])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Unit {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  nameAr       String?   @db.VarChar(100)
  abbreviation String    @db.VarChar(20)
  isBase       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products         Product[]         @relation("BaseUnit")
  purchaseProducts Product[]         @relation("PurchaseUnit")
  saleProducts     Product[]         @relation("SaleUnit")
  fromConversions  UnitConversion[]  @relation("FromUnit")
  toConversions    UnitConversion[]  @relation("ToUnit")
  purchaseItems    PurchaseItem[]
  saleItems        SalesInvoiceItem[]
  stockMovements   StockMovement[]

  @@index([name])
  @@map("units")
}

// 1 fromUnit = ratio toUnit  (e.g. 1 CARTON = 24 PIECES)
model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  ratio      Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUnit Unit @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit @relation("ToUnit",   fields: [toUnitId],   references: [id])

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("unit_conversions")
}

model TaxRate {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(100)
  rate      Decimal   @db.Decimal(8, 4)
  type      TaxType   @default(EXCLUSIVE)
  isDefault Boolean   @default(false)
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@map("tax_rates")
}

model Product {
  id             String        @id @default(uuid())
  categoryId     String?
  brandId        String?
  baseUnitId     String
  purchaseUnitId String?
  saleUnitId     String?
  taxRateId      String?
  sku            String        @unique @db.VarChar(100)
  name           String        @db.VarChar(300)
  nameAr         String?       @db.VarChar(300)
  description    String?
  purchasePrice  Decimal       @db.Decimal(18, 3)
  sellingPrice   Decimal       @db.Decimal(18, 3)
  wholesalePrice Decimal?      @db.Decimal(18, 3)
  taxType        TaxType       @default(EXCLUSIVE)
  reorderLevel   Int           @default(10)
  maxStock       Int?
  weight         Decimal?      @db.Decimal(10, 3)
  shelfLocation  String?       @db.VarChar(100)
  status         ProductStatus @default(ACTIVE)
  isForSale      Boolean       @default(true)
  trackExpiry    Boolean       @default(false)
  trackSerial    Boolean       @default(false)
  hasVariants    Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category     Category? @relation(fields: [categoryId],    references: [id])
  brand        Brand?    @relation(fields: [brandId],       references: [id])
  baseUnit     Unit      @relation("BaseUnit",     fields: [baseUnitId],     references: [id])
  purchaseUnit Unit?     @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  saleUnit     Unit?     @relation("SaleUnit",     fields: [saleUnitId],     references: [id])
  taxRate      TaxRate?  @relation(fields: [taxRateId],     references: [id])

  barcodes            ProductBarcode[]
  images              ProductImage[]
  priceHistories      ProductPriceHistory[]
  costHistories       ProductCostHistory[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  purchaseItems       PurchaseItem[]
  saleItems           SalesInvoiceItem[]
  returnItems         SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  promotionItems      PromotionItem[]

  @@index([sku])
  @@index([name])
  @@index([nameAr])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductBarcode {
  id        String    @id @default(uuid())
  productId String
  barcode   String    @unique @db.VarChar(100)
  isPrimary Boolean   @default(false)
  source    String?   @db.VarChar(50)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id])

  @@index([barcode])
  @@index([productId])
  @@map("product_barcodes")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

// IMMUTABLE price history log
model ProductPriceHistory {
  id          String    @id @default(uuid())
  productId   String
  branchId    String?
  changedById String
  priceType   PriceType
  oldPrice    Decimal   @db.Decimal(18, 3)
  newPrice    Decimal   @db.Decimal(18, 3)
  reason      String?   @db.VarChar(500)
  source      String    @db.VarChar(50)
  invoiceRef  String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())

  product   Product  @relation(fields: [productId],   references: [id])
  branch    Branch?  @relation(fields: [branchId],    references: [id])
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([createdAt])
  @@index([productId, priceType, createdAt])
  @@map("product_price_histories")
}

// IMMUTABLE cost history log
model ProductCostHistory {
  id          String    @id @default(uuid())
  productId   String
  supplierId  String?
  branchId    String?
  changedById String
  purchaseRef String?   @db.VarChar(100)
  oldCost     Decimal   @db.Decimal(18, 3)
  newCost     Decimal   @db.Decimal(18, 3)
  source      String    @db.VarChar(50)
  notes       String?
  createdAt   DateTime  @default(now())

  product   Product   @relation(fields: [productId],   references: [id])
  supplier  Supplier? @relation(fields: [supplierId],  references: [id])
  branch    Branch?   @relation(fields: [branchId],    references: [id])
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@map("product_cost_histories")
}

// Current stock snapshot per product/branch/warehouse
model StockBalance {
  id          String   @id @default(uuid())
  productId   String
  branchId    String
  warehouseId String
  quantity    Decimal  @db.Decimal(18, 4)
  reservedQty Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId],   references: [id])
  branch    Branch    @relation(fields: [branchId],    references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, branchId, warehouseId])
  @@index([productId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([productId, branchId])
  @@map("stock_balances")
}

// IMMUTABLE stock movement ledger
model StockMovement {
  id            String                 @id @default(uuid())
  productId     String
  branchId      String
  warehouseId   String
  unitId        String
  movementType  StockMovementType
  direction     StockMovementDirection
  quantity      Decimal                @db.Decimal(18, 4)
  baseQuantity  Decimal                @db.Decimal(18, 4)
  costPerUnit   Decimal?               @db.Decimal(18, 3)
  batchNumber   String?                @db.VarChar(100)
  expiryDate    DateTime?              @db.Date
  sourceModule  String                 @db.VarChar(50)
  referenceId   String?                @db.VarChar(100)
  referenceType String?                @db.VarChar(50)
  referenceNum  String?                @db.VarChar(100)
  notes         String?
  returnReason  ReturnReason?
  createdById   String
  createdAt     DateTime               @default(now())

  product   Product   @relation(fields: [productId],  references: [id])
  branch    Branch    @relation(fields: [branchId],   references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  unit      Unit      @relation(fields: [unitId],     references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceId, referenceType])
  @@index([productId, branchId, createdAt])
  @@index([batchNumber])
  @@map("stock_movements")
}

model Customer {
  id            String       @id @default(uuid())
  code          String       @unique @db.VarChar(30)
  name          String       @db.VarChar(200)
  nameAr        String?      @db.VarChar(200)
  customerType  CustomerType @default(WALKIN)
  phone         String?      @db.VarChar(30)
  whatsapp      String?      @db.VarChar(30)
  email         String?      @db.VarChar(200)
  address       String?
  city          String?      @db.VarChar(100)
  creditLimit   Decimal      @default(0) @db.Decimal(18, 3)
  creditBalance Decimal      @default(0) @db.Decimal(18, 3)
  loyaltyPoints Int          @default(0)
  taxNumber     String?      @db.VarChar(50)
  notes         String?
  status        String       @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  sales        SalesInvoice[]
  salesReturns SalesReturn[]
  creditLedger CustomerCreditLedger[]

  @@index([name])
  @@index([phone])
  @@index([whatsapp])
  @@index([customerType])
  @@index([deletedAt])
  @@index([code])
  @@map("customers")
}

model CustomerCreditLedger {
  id          String   @id @default(uuid())
  customerId  String
  invoiceId   String?
  description String   @db.VarChar(500)
  debit       Decimal  @default(0) @db.Decimal(18, 3)
  credit      Decimal  @default(0) @db.Decimal(18, 3)
  balance     Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id])
  invoice  SalesInvoice? @relation(fields: [invoiceId],  references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_credit_ledgers")
}

model Supplier {
  id          String    @id @default(uuid())
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(200)
  nameAr      String?   @db.VarChar(200)
  contactName String?   @db.VarChar(200)
  phone       String?   @db.VarChar(30)
  whatsapp    String?   @db.VarChar(30)
  email       String?   @db.VarChar(200)
  address     String?
  taxNumber   String?   @db.VarChar(50)
  creditDays  Int       @default(0)
  balance     Decimal   @default(0) @db.Decimal(18, 3)
  notes       String?
  status      String    @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  costHistories ProductCostHistory[]
  returns       PurchaseReturn[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@index([code])
  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(uuid())
  branchId       String
  warehouseId    String?
  supplierId     String?
  createdById    String
  docNumber      String         @db.VarChar(50)
  supplierRef    String?        @db.VarChar(100)
  status         PurchaseStatus @default(DRAFT)
  orderDate      DateTime       @db.Date
  expectedDate   DateTime?      @db.Date
  receivedDate   DateTime?      @db.Date
  subtotal       Decimal        @db.Decimal(18, 3)
  taxAmount      Decimal        @default(0) @db.Decimal(18, 3)
  discountAmount Decimal        @default(0) @db.Decimal(18, 3)
  totalAmount    Decimal        @db.Decimal(18, 3)
  paidAmount     Decimal        @default(0) @db.Decimal(18, 3)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  branch    Branch    @relation(fields: [branchId],   references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items   PurchaseItem[]
  returns PurchaseReturn[]

  @@unique([branchId, docNumber])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([docNumber])
  @@map("purchases")
}

model PurchaseItem {
  id             String    @id @default(uuid())
  purchaseId     String
  productId      String
  unitId         String
  orderedQty     Decimal   @db.Decimal(18, 4)
  receivedQty    Decimal   @default(0) @db.Decimal(18, 4)
  baseQty        Decimal   @default(0) @db.Decimal(18, 4)
  costPerUnit    Decimal   @db.Decimal(18, 3)
  taxRate        Decimal   @default(0) @db.Decimal(8, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(18, 3)
  discountAmount Decimal   @default(0) @db.Decimal(18, 3)
  lineTotal      Decimal   @db.Decimal(18, 3)
  batchNumber    String?   @db.VarChar(100)
  expiryDate     DateTime? @db.Date
  sellingPrice   Decimal?  @db.Decimal(18, 3)
  createdAt      DateTime  @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId],  references: [id])
  unit     Unit     @relation(fields: [unitId],      references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReturn {
  id          String       @id @default(uuid())
  purchaseId  String
  supplierId  String?
  branchId    String
  createdById String?
  docNumber   String       @db.VarChar(50)
  reason      ReturnReason
  notes       String?
  totalAmount Decimal      @db.Decimal(18, 3)
  status      String       @default("COMPLETED") @db.VarChar(20)
  createdAt   DateTime     @default(now())

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  items PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([branchId])
  @@index([docNumber])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String   @id @default(uuid())
  purchaseReturnId String
  productId        String
  quantity         Decimal  @db.Decimal(18, 4)
  baseQuantity     Decimal  @db.Decimal(18, 4)
  costPerUnit      Decimal  @db.Decimal(18, 3)
  lineTotal        Decimal  @db.Decimal(18, 3)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  product        Product        @relation(fields: [productId],        references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model SalesInvoice {
  id              String        @id @default(uuid())
  branchId        String
  warehouseId     String?
  customerId      String?
  shiftId         String?
  createdById     String
  docNumber       String        @db.VarChar(50)
  status          SaleStatus    @default(COMPLETED)
  saleDate        DateTime      @default(now())
  customerType    CustomerType  @default(WALKIN)
  deliveryAddress String?
  deliveryPhone   String?
  subtotal        Decimal       @db.Decimal(18, 3)
  taxAmount       Decimal       @default(0) @db.Decimal(18, 3)
  discountAmount  Decimal       @default(0) @db.Decimal(18, 3)
  discountPercent Decimal       @default(0) @db.Decimal(8, 4)
  totalAmount     Decimal       @db.Decimal(18, 3)
  paidAmount      Decimal       @db.Decimal(18, 3)
  changeAmount    Decimal       @default(0) @db.Decimal(18, 3)
  creditAmount    Decimal       @default(0) @db.Decimal(18, 3)
  paymentMethod   PaymentMethod @default(CASH)
  notes           String?
  voidReason      String?
  voidedAt        DateTime?
  voidedById      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch    Branch    @relation(fields: [branchId],   references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  shift     Shift?    @relation(fields: [shiftId],    references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items            SalesInvoiceItem[]
  returns          SalesReturn[]
  payments         PaymentTransaction[]
  creditLedgers    CustomerCreditLedger[]
  approvalRequests ApprovalRequest[]

  @@unique([branchId, docNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([shiftId])
  @@index([status])
  @@index([saleDate])
  @@index([docNumber])
  @@index([createdAt])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id                 String   @id @default(uuid())
  invoiceId          String
  productId          String
  unitId             String
  quantity           Decimal  @db.Decimal(18, 4)
  baseQuantity       Decimal  @db.Decimal(18, 4)
  originalPrice      Decimal  @db.Decimal(18, 3)
  unitPrice          Decimal  @db.Decimal(18, 3)
  discountAmount     Decimal  @default(0) @db.Decimal(18, 3)
  discountPercent    Decimal  @default(0) @db.Decimal(8, 4)
  taxRate            Decimal  @default(0) @db.Decimal(8, 4)
  taxAmount          Decimal  @default(0) @db.Decimal(18, 3)
  lineTotal          Decimal  @db.Decimal(18, 3)
  costAtSale         Decimal? @db.Decimal(18, 3)
  batchNumber        String?  @db.VarChar(100)
  expiryDate         DateTime? @db.Date
  priceOverridden    Boolean  @default(false)
  promotionId        String?
  createdAt          DateTime @default(now())

  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  unit      Unit         @relation(fields: [unitId],    references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

model SalesReturn {
  id           String        @id @default(uuid())
  invoiceId    String
  customerId   String?
  branchId     String?
  createdById  String?
  docNumber    String        @db.VarChar(50)
  reason       ReturnReason
  notes        String?
  totalAmount  Decimal       @db.Decimal(18, 3)
  refundMethod PaymentMethod?
  status       String        @default("COMPLETED") @db.VarChar(20)
  createdAt    DateTime      @default(now())

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])

  items SalesReturnItem[]

  @@index([invoiceId])
  @@index([createdAt])
  @@index([docNumber])
  @@map("sales_returns")
}

model SalesReturnItem {
  id           String        @id @default(uuid())
  returnId     String
  productId    String
  quantity     Decimal       @db.Decimal(18, 4)
  baseQuantity Decimal       @db.Decimal(18, 4)
  unitPrice    Decimal       @db.Decimal(18, 3)
  lineTotal    Decimal       @db.Decimal(18, 3)
  returnReason ReturnReason?

  return  SalesReturn @relation(fields: [returnId],  references: [id])
  product Product     @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@map("sales_return_items")
}

model PaymentTransaction {
  id        String        @id @default(uuid())
  invoiceId String?
  shiftId   String?
  method    PaymentMethod
  amount    Decimal       @db.Decimal(18, 3)
  reference String?       @db.VarChar(200)
  notes     String?
  createdAt DateTime      @default(now())

  invoice SalesInvoice? @relation(fields: [invoiceId], references: [id])
  shift   Shift?        @relation(fields: [shiftId],   references: [id])

  @@index([invoiceId])
  @@index([shiftId])
  @@index([method])
  @@map("payment_transactions")
}

model Shift {
  id            String      @id @default(uuid())
  branchId      String
  cashierId     String
  docNumber     String      @db.VarChar(50)
  status        ShiftStatus @default(OPEN)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  openingCash   Decimal     @db.Decimal(18, 3)
  closingCash   Decimal?    @db.Decimal(18, 3)
  expectedCash  Decimal?    @db.Decimal(18, 3)
  cashVariance  Decimal?    @db.Decimal(18, 3)
  totalSales    Decimal     @default(0) @db.Decimal(18, 3)
  totalReturns  Decimal     @default(0) @db.Decimal(18, 3)
  totalCash     Decimal     @default(0) @db.Decimal(18, 3)
  totalCard     Decimal     @default(0) @db.Decimal(18, 3)
  totalKnet     Decimal     @default(0) @db.Decimal(18, 3)
  totalCredit   Decimal     @default(0) @db.Decimal(18, 3)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  branch  Branch @relation(fields: [branchId],  references: [id])
  cashier User   @relation(fields: [cashierId], references: [id])

  sales         SalesInvoice[]
  cashMovements CashMovement[]
  payments      PaymentTransaction[]

  @@unique([branchId, docNumber])
  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([openedAt])
  @@map("shifts")
}

model CashMovement {
  id          String   @id @default(uuid())
  shiftId     String
  type        String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(18, 3)
  reason      String   @db.VarChar(300)
  createdById String?
  createdAt   DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@map("cash_movements")
}

model Promotion {
  id                String       @id @default(uuid())
  branchId          String?
  name              String       @db.VarChar(200)
  code              String?      @unique @db.VarChar(50)
  type              DiscountType
  discountValue     Decimal      @db.Decimal(18, 3)
  minCartValue      Decimal?     @db.Decimal(18, 3)
  maxDiscount       Decimal?     @db.Decimal(18, 3)
  buyQuantity       Int?
  getQuantity       Int?
  maxUsage          Int?
  usageCount        Int          @default(0)
  requiresApproval  Boolean      @default(false)
  approvalThreshold Decimal?     @db.Decimal(8, 4)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  branch Branch?        @relation(fields: [branchId], references: [id])
  items  PromotionItem[]

  @@index([branchId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([code])
  @@map("promotions")
}

model PromotionItem {
  id          String  @id @default(uuid())
  promotionId String
  productId   String?
  categoryId  String?
  brandId     String?
  sortOrder   Int     @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id])
  product   Product?  @relation(fields: [productId],   references: [id])

  @@index([promotionId])
  @@map("promotion_items")
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  action        ApprovalAction
  status        ApprovalStatus @default(PENDING)
  requesterId   String
  approverId    String?
  invoiceId     String?
  entityId      String?        @db.VarChar(100)
  entityType    String?        @db.VarChar(50)
  metadata      Json?
  requestNotes  String?
  responseNotes String?
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())

  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  requestedBy User          @relation("ApprovalRequester", fields: [requesterId], references: [id], map: "approval_requests_requesterId_fkey")
  approvedBy  User?         @relation("ApprovalApprover",  fields: [approverId],  references: [id], map: "approval_requests_approverId_fkey")

  @@index([action])
  @@index([status])
  @@index([requesterId])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("approval_requests")
}

model DocumentSequence {
  id         String          @id @default(uuid())
  branchId   String
  docType    SequenceDocType
  prefix     String          @db.VarChar(20)
  lastNumber Int             @default(0)
  padLength  Int             @default(6)
  updatedAt  DateTime        @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, docType])
  @@map("document_sequences")
}

model Expense {
  id          String    @id @default(uuid())
  branchId    String
  shiftId     String?
  category    String    @db.VarChar(100)
  description String
  amount      Decimal   @db.Decimal(18, 3)
  reference   String?   @db.VarChar(100)
  expenseDate DateTime  @db.Date
  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([expenseDate])
  @@map("expenses")
}

model Setting {
  id        String   @id @default(uuid())
  branchId  String?
  key       String   @db.VarChar(100)
  value     String
  group     String   @db.VarChar(50)
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
  @@index([branchId])
  @@index([group])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  module     String      @db.VarChar(50)
  entityId   String?     @db.VarChar(100)
  entityType String?     @db.VarChar(50)
  oldValues  Json?
  newValues  Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?
  branchId   String?
  notes      String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityId, entityType])
  @@index([createdAt])
  @@index([branchId])
  @@map("audit_logs")
}

model ImportJob {
  id           String       @id @default(uuid())
  branchId     String?
  createdById  String?
  entityType   String       @db.VarChar(50)
  fileName     String       @db.VarChar(300)
  totalRows    Int          @default(0)
  successRows  Int          @default(0)
  failedRows   Int          @default(0)
  status       ImportStatus @default(PENDING)
  errorSummary String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  createdBy User?         @relation(fields: [createdById], references: [id])
  rows      ImportJobRow[]

  @@index([createdById])
  @@index([status])
  @@index([entityType])
  @@map("import_jobs")
}

model ImportJobRow {
  id         String   @id @default(uuid())
  jobId      String
  rowNumber  Int
  rawData    Json
  mappedData Json?
  status     String   @db.VarChar(20)
  errors     Json?
  createdAt  DateTime @default(now())

  job ImportJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
  @@map("import_job_rows")
}
